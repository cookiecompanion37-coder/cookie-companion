# ── Server-only secrets. Never prefix these with NEXT_PUBLIC_. ────────────────
# Chat LLM (OpenAI-compatible router used by /api/chat)
ZERO_BASE_URL=https://bflqlfkmfwrtgftvywce.supabase.co/functions/v1/router/v1
ZERO_API_KEY=replace-me
ZERO_MODEL=zero-pro-1.2

# VModel — image generation (server side only)
# https://vmodel.ai/docs/api/ → API token from the dashboard
VMODEL_API_TOKEN=
VMODEL_BASE_URL=https://api.vmodel.ai
VMODEL_VERSION=cce611c44553ba5f061813d75a1e5f93d8c901047528da275f667ebe7d784565

# Supabase — optional persistence for generated photos and shared characters.
# Leave blank to stay fully local (photos stay as compressed data URLs).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=cookie-photos

# Optional: GPU node registry (voice/image/call routes). Defaults are baked in.
# GPU_NODE_SUPABASE_URL=
# GPU_NODE_SUPABASE_ANON_KEY=

# Stories — AI posts are copied into the temporary bucket, never hot-linked
# from the GPU tunnel. 80/day is the hard cap; the times themselves are random.
SUPABASE_STORY_BUCKET=cookie-stories
AI_STORIES_PER_DAY=80
# Used to shape how densely the random plan fills a day. Defaults to the cap.
# Hard daily ceiling for AI stories (edit to change the cap), and the soft target the planner fills to.
AI_STORIES_PER_DAY=80
AI_STORY_DAILY_TARGET=80
# Absolute origin, used to fetch persona portraits as img2img references.
# On Vercel the request origin is used automatically; this is a fallback.
SITE_URL=

# Persona factory hard stop. Also enforced in the admin UI.
MAX_AI_PROFILES=400

# Admin panel ("Cookie Studio") — email + passcode trade for an HMAC cookie.
# Change all three before deploying. ADMIN_SECRET signs the cookie (12 h).
ADMIN_EMAIL=admin@cookie.app
ADMIN_PASSCODE=cookie-admin
ADMIN_SECRET=replace-with-a-long-random-string

# Scheduler auth: Vercel cron and GitHub Actions send this as a Bearer token.
# Admin sessions also count as trusted, so the panel can trigger runs by hand.
CRON_SECRET=replace-with-another-long-random-string
